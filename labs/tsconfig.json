{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": { "@lab/*": ["./src/*"] }
  },
  "include": ["src", "shared", "labs", "solutions", "vitest.config.ts"]
}
